QWidget#centralwidget{
    background:#EEF3F8;
    color:#26364A;
    font-family:&quot;Microsoft YaHei UI&quot;,&quot;Microsoft YaHei&quot;;
    font-size:9pt;
}
QFrame#frameHeader{
    background:#FFFFFF;
    border:1px solid #D9E3EE;
    border-radius:9px;
}
QFrame#frameTabs{
    background:#EFF4F9;
    border:1px solid #DCE5EF;
    border-radius:16px;
}
QGroupBox{
    margin-top:13px;
    border:1px solid #D9E3EE;
    border-radius:7px;
    background:#FFFFFF;
    font-weight:600;
}
QGroupBox::title{
    subcontrol-origin:margin;
    subcontrol-position:top left;
    left:11px;
    padding:0 5px;
    color:#24558A;
    background:#FFFFFF;
}
QLabel{ color:#405269; }
QLabel#labelTitle{ color:#17263A; font-size:13pt; font-weight:700; }
QLabel#labelSubTitle,QLabel#labelBreadcrumb{ color:#7B8A9C; }
QLabel#labelStatusValue{ color:#15803D; font-weight:600; }
QLabel#labelStatusDot{ background:#22C55E; border-radius:6px; }
QLabel#label_blurKsize,QLabel#label_cannyHi,QLabel#label_cannyLo,QLabel#label_minArea,
QLabel#label_morphKsize,QLabel#label_smoothWindow,QLabel#label{
    min-width:66px; max-width:66px;
}
QLabel#label_calibCxTitle,QLabel#label_calibCyTitle,QLabel#label_calibRadiusTitle,
QLabel#label_calibOffsetTitle{
    min-width:70px; max-width:70px;
}
QLabel#label_calibCxValue,QLabel#label_calibRadiusValue{
    min-width:58px; max-width:58px;
}
QLabel#label_calibCyValue,QLabel#label_calibOffsetValue{
    min-width:106px; max-width:106px;
}
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox{
    min-height:20px;
    padding:1px 6px;
    border:1px solid #C7D3E0;
    border-radius:4px;
    background:#FFFFFF;
    color:#24364D;
    selection-background-color:#2F6FED;
}
QLineEdit:focus,QComboBox:focus,QSpinBox:focus,QDoubleSpinBox:focus{
    border:1px solid #2F6FED;
    background:#F8FBFF;
}
QPushButton{
    min-height:24px;
    padding:0 10px;
    border:1px solid #2F6FED;
    border-radius:5px;
    background:#2F6FED;
    color:#FFFFFF;
    font-weight:500;
}
QPushButton:hover{ background:#245ECC; border-color:#245ECC; }
QPushButton:pressed{ background:#1E4C9F; border-color:#1E4C9F; }
QPushButton:disabled{ background:#D9E2EC; border-color:#CBD5E1; color:#94A3B8; }
QPushButton#CloseButton,QPushButton#ClearButton,QPushButton#btnCalibResetParams,
QPushButton#btnClosePreview,QPushButton#btnReset,QPushButton#BT_chuankou_guanbi,
QPushButton#BT_chuankou_shuaxin{
    background:#FFFFFF; border-color:#C7D3E0; color:#52647A;
}
QPushButton#CloseButton:hover,QPushButton#ClearButton:hover,QPushButton#btnCalibResetParams:hover,
QPushButton#btnClosePreview:hover,QPushButton#btnReset:hover,QPushButton#BT_chuankou_guanbi:hover,
QPushButton#BT_chuankou_shuaxin:hover{
    background:#F5F8FC; border-color:#94A3B8; color:#26496F;
}
QPushButton#BT_chuankou_tongxunzhongduan,QPushButton#BT_tanzhengtingzhi{
    background:#DC2626; border-color:#DC2626; color:#FFFFFF; font-weight:700;
}
QPushButton#BT_chuankou_tongxunzhongduan:hover,QPushButton#BT_tanzhengtingzhi:hover{
    background:#B91C1C; border-color:#B91C1C;
}
QPushButton#btnTopCalibration,QPushButton#btnTopMachineControl,
QPushButton#btnTopImaging,QPushButton#btnTopSegmentation{
    min-height:24px; padding:3px 12px; border:none; border-radius:13px;
    background:transparent; color:#52647A; font-weight:600;
}
QPushButton#btnTopCalibration:hover,QPushButton#btnTopMachineControl:hover,
QPushButton#btnTopImaging:hover,QPushButton#btnTopSegmentation:hover{
    background:#FFFFFF; color:#24558A;
}
QTabWidget::pane{ border:1px solid #D9E3EE; border-radius:6px; background:#FFFFFF; }
QTabBar::tab{
    min-height:25px; padding:4px 12px; border:1px solid #D9E3EE; border-bottom:none;
    border-top-left-radius:5px; border-top-right-radius:5px; background:#EFF4F9; color:#64748B;
}
QTabBar::tab:selected{ background:#FFFFFF; color:#24558A; font-weight:700; }
QProgressBar{
    border:1px solid #D9E3EE; border-radius:6px; background:#F8FAFC; color:#52647A; text-align:center;
}
QProgressBar::chunk{ border-radius:5px; background:#22C55E; }
QPlainTextEdit{
    padding:6px; border:1px solid #24364D; border-radius:5px; background:#111827;
    color:#86EFAC; font-family:Consolas,&quot;Courier New&quot;; font-size:8.5pt;
}
QScrollArea{ border:none; background:transparent; }
QScrollArea#scrollAreaCalibrationSettings,QScrollArea#scrollAreaMachineSettings,
QScrollArea#scrollAreaImagingSettings,QScrollArea#scrollAreaSegmentationSettings{
    border:1px solid #E1E8F0; border-radius:6px; background:#EDF3F8;
}
QScrollBar:vertical{ width:7px; margin:1px; border:none; border-radius:4px; background:#DDE6EF; }
QScrollBar::handle:vertical{ min-height:28px; border-radius:4px; background:#9BAFC3; }
QScrollBar::handle:vertical:hover{ background:#71869B; }
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical{ height:0; background:none; }
QSlider::groove:horizontal{ height:4px; border-radius:2px; background:#D9E3EE; }
QSlider::handle:horizontal{ width:14px; margin:-5px 0; border-radius:7px; background:#2F6FED; }
QCheckBox{ spacing:6px; color:#405269; }


