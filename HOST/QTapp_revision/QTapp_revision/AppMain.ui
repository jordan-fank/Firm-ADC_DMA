/* Reveal scrollbars only on interaction */
QScrollBar:vertical{
    width:8px;
    margin:1px;
    border:none;
    background:transparent;
}
QScrollBar::handle:vertical{
    min-height:28px;
    border-radius:4px;
    background:transparent;
}
QScrollBar::handle:vertical:hover{
    background:#AABBC4;
}
QScrollBar:horizontal{
    height:8px;
    margin:1px;
    border:none;
    background:transparent;
}
QScrollBar::handle:horizontal{
    min-width:28px;
    border-radius:4px;
    background:transparent;
}
QScrollBar::handle:horizontal:hover{
    background:#AABBC4;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal{
    width:0;
    height:0;
    border:none;
    background:transparent;
}

/* Prevent mixed-language captions from clipping */
QGroupBox{
    margin-top:17px;
}
QGroupBox::title{
    subcontrol-origin:margin;
    subcontrol-position:top left;
    left:10px;
    padding:1px 6px 2px 6px;
    background:transparent;
}
QGroupBox#groupBox_calibPreview,
QGroupBox#groupBox_imagingResult,
QGroupBox#groupBox_segResult{
    margin-top:18px;
}
QGroupBox#groupBox_calibPreview::title,
QGroupBox#groupBox_imagingResult::title,
QGroupBox#groupBox_segResult::title{
    padding:1px 7px 3px 7px;
    color:#315F7D;
    background:transparent;
}
QTabBar::tab{
    min-height:27px;
    padding:5px 12px;
}

/* Final layout polish */
QPushButton#btnTopCalibration,
QPushButton#btnTopMachineControl,
QPushButton#btnTopImaging,
QPushButton#btnTopSegmentation{
    min-height:28px;
    max-height:28px;
    padding:0;
    border:none;
    border-radius:14px;
}
QGroupBox#groupBoxSerial QLabel,
QGroupBox#groupBoxSerial QComboBox,
QGroupBox#groupBoxSerial QPushButton{
    min-height:32px;
    max-height:32px;
}
QGroupBox#groupBoxSerial QComboBox{
    padding:0 10px;
}
/* Final preview canvas override */
QGroupBox#groupBox_calibPreview,
QGroupBox#groupBox_imagingResult,
QGroupBox#groupBox_segResult{
    border-color:#C8D6DF;
    background:#FFFFFF;
}
QLabel#labelCalibCameraView,
QLabel#labelImagePreview,
QLabel#labelPreview2D,
QLabel#labelPreview3D{
    border:1px solid #BFD0DB;
    border-radius:7px;
    background:#E9F0F4;
    color:#516A7A;
    font-weight:600;
}
QLabel#labelCalibCameraView{
    color:#315F7D;
    font-family:Consolas,&quot;Microsoft YaHei UI&quot;;
}
QLabel#labelImagePreview,
QLabel#labelPreview2D,
QLabel#labelPreview3D{
    color:#516A7A;
    font-family:&quot;Microsoft YaHei UI&quot;,&quot;Microsoft YaHei&quot;;
}
QScrollArea#scrollAreaImaging,
QScrollArea#scrollAreaPreview2D,
QScrollArea#scrollAreaPreview3D{
    border:1px solid #BFD0DB;
    border-radius:7px;
    background:#E9F0F4;
}
QScrollArea#scrollAreaImaging QWidget,
QScrollArea#scrollAreaPreview2D QWidget,
QScrollArea#scrollAreaPreview3D QWidget{
    background:#E9F0F4;
    color:#516A7A;
}
QGroupBox#groupBoxLogMachine{
    border-color:#C8D6DF;
    background:#FFFFFF;
}
QPlainTextEdit#plainTextEdit{
    padding:8px;
    border:1px solid #BFD0DB;
    border-radius:7px;
    background:#E9F0F4;
    color:#405966;
    selection-background-color:#BCD5E3;
    selection-color:#20343E;
    font-family:Consolas,&quot;Microsoft YaHei UI&quot;;
    font-size:9pt;
}

/* Final professional bright palette */
QWidget#centralwidget{
    background:#F7FBFF;
    color:#223843;
}
QFrame#frameHeader{
    background:#FFFFFF;
    border:1px solid #D7E6EF;
    border-radius:8px;
}
QFrame#frameTabs{
    background:#EDF6FB;
    border:1px solid #D1E4EF;
    border-radius:16px;
}
QGroupBox{
    border:1px solid #D3E4EE;
    background:#FFFFFF;
    color:#223843;
}
QGroupBox::title{
    color:#176A9A;
    background:transparent;
}
QLabel{
    color:#365766;
}
QLabel#labelTitle{
    color:#173246;
}
QLabel#labelSubTitle,
QLabel#labelBreadcrumb,
QLabel#labelStatusText,
QLabel#labelVersion,
QLabel#labelWindowScale{
    color:#6C8796;
}
QLabel#labelLogoText,
QLabel#labelCLAHETitle,
QLabel#labelPostTitle{
    color:#176A9A;
}
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox{
    border:1px solid #C7DCE8;
    background:#FFFFFF;
    color:#223843;
    selection-background-color:#B9DAEE;
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover{
    border-color:#95BFD4;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus{
    border:1px solid #2D8BBF;
    background:#FFFFFF;
}
QPushButton{
    border:1px solid #2D7FA8;
    background:#2D7FA8;
    color:#FFFFFF;
}
QPushButton:hover{
    border-color:#226E95;
    background:#226E95;
}
QPushButton:pressed{
    border-color:#185A7C;
    background:#185A7C;
}
QPushButton#CloseButton,
QPushButton#ClearButton,
QPushButton#btnCalibResetParams,
QPushButton#btnClosePreview,
QPushButton#btnReset,
QPushButton#BT_chuankou_guanbi,
QPushButton#BT_chuankou_shuaxin,
QPushButton#browseButton,
QPushButton#btnBrowseOutputDir,
QPushButton#btnBrowseSeg{
    border-color:#C7DCE8;
    background:#FFFFFF;
    color:#365766;
}
QPushButton#CloseButton:hover,
QPushButton#ClearButton:hover,
QPushButton#btnCalibResetParams:hover,
QPushButton#btnClosePreview:hover,
QPushButton#btnReset:hover,
QPushButton#BT_chuankou_guanbi:hover,
QPushButton#BT_chuankou_shuaxin:hover,
QPushButton#browseButton:hover,
QPushButton#btnBrowseOutputDir:hover,
QPushButton#btnBrowseSeg:hover{
    border-color:#99C2D6;
    background:#F0F8FC;
    color:#176A9A;
}
QPushButton#btnTopCalibration,
QPushButton#btnTopMachineControl,
QPushButton#btnTopImaging,
QPushButton#btnTopSegmentation{
    background:transparent;
    color:#506F7E;
}
QPushButton#btnTopCalibration:hover,
QPushButton#btnTopMachineControl:hover,
QPushButton#btnTopImaging:hover,
QPushButton#btnTopSegmentation:hover{
    background:#FFFFFF;
    color:#176A9A;
}
QTabWidget::pane{
    border:1px solid #D3E4EE;
    background:#FFFFFF;
}
QTabBar::tab{
    border-color:#D3E4EE;
    background:#F1F8FC;
    color:#587484;
}
QTabBar::tab:hover{
    background:#E8F4FA;
    color:#176A9A;
}
QTabBar::tab:selected{
    background:#FFFFFF;
    color:#176A9A;
}
QScrollArea#scrollAreaCalibrationSettings,
QScrollArea#scrollAreaMachineSettings,
QScrollArea#scrollAreaImagingSettings,
QScrollArea#scrollAreaSegmentationSettings,
QWidget#scrollAreaWidgetContentsCalibrationSettings,
QWidget#scrollAreaWidgetContentsMachineSettings,
QWidget#scrollAreaWidgetContentsImagingSettings,
QWidget#scrollAreaWidgetContentsSegmentationSettings{
    background:#F2F8FC;
}
QGroupBox#groupBox_calibPreview,
QGroupBox#groupBox_imagingResult,
QGroupBox#groupBox_segResult,
QGroupBox#groupBoxLogMachine{
    border-color:#C6D9E6;
    background:#FFFFFF;
}
QLabel#labelCalibCameraView,
QLabel#labelImagePreview,
QLabel#labelPreview2D,
QLabel#labelPreview3D,
QPlainTextEdit#plainTextEdit{
    border:1px solid #C6D9E6;
    background:#EAF4FB;
    color:#365766;
}
QLabel#labelCalibCameraView{
    color:#176A9A;
}
QScrollArea#scrollAreaImaging,
QScrollArea#scrollAreaPreview2D,
QScrollArea#scrollAreaPreview3D{
    border:1px solid #C6D9E6;
    background:#EAF4FB;
}
QScrollArea#scrollAreaImaging QWidget,
QScrollArea#scrollAreaPreview2D QWidget,
QScrollArea#scrollAreaPreview3D QWidget{
    background:#EAF4FB;
    color:#365766;
}
QProgressBar{
    border-color:#C6D9E6;
    background:#F0F7FB;
    color:#365766;
}
QProgressBar::chunk{
    background:#2D8BBF;
}

/* Quiet persistent scrollbars */
QScrollBar:vertical{
    width:8px;
    margin:1px;
    border:none;
    border-radius:4px;
    background:#E9EEF1;
}
QScrollBar::handle:vertical{
    min-height:30px;
    border-radius:4px;
    background:#C3CFD5;
}
QScrollBar::handle:vertical:hover{
    background:#9FB2BC;
}
QScrollBar:horizontal{
    height:8px;
    margin:1px;
    border:none;
    border-radius:4px;
    background:#E9EEF1;
}
QScrollBar::handle:horizontal{
    min-width:30px;
    border-radius:4px;
    background:#C3CFD5;
}
QScrollBar::handle:horizontal:hover{
    background:#9FB2BC;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal{
    width:0;
    height:0;
    border:none;
    background:transparent;
}
