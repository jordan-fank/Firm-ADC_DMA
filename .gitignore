# ===== Keil MDK 编译产物 =====
OBJ/

# ===== 构建日志 =====
*.log

# ===== Keil IDE 本地状态（因机器/用户而异，不应共享）=====
USER/*.uvgui.*
USER/*.uvguix.*
USER/*.uvopt
USER/*.uvoptx
USER/*.saved_uv4
.vscode/
USER/DebugConfig/
USER/EventRecorderStub.scvd
USER/JLinkLog.txt
USER/JLinkSettings.ini
USER/RTE/

# ===== 其他工具的数据目录 =====
.codegraph/
.reasonix/
.spec-workflow/

# ===== EIDE/VSCode 工具链下载的厂商 SDK（ARM CMSIS + Keil DFP，可重新下载，不入库）=====
USER/.cmsis/
USER/.pack/

# ===== understand-anything 的清理垃圾（保留图谱与基线数据）=====
.ua/.trash-*/

# ===== understand-anything 增量分析的中间产物（保留 scan-result.json 供增量跳过 Phase 1）=====
.ua/intermediate/*
!.ua/intermediate/scan-result.json
